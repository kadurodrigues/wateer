# Copy to .env and fill in. .env is gitignored.

# YouTube Data API v3 key, used server-side to look up video durations.
# Optional: without it the app still works, but durations are unavailable.
# Never rename this to VITE_YOUTUBE_API_KEY — VITE_* vars are bundled into
# the client and would expose the key publicly.
YOUTUBE_API_KEY=

# Supabase, for signing in and syncing across devices. Optional: without them
# the app keeps everything in the browser. Both are meant to be public — the
# publishable key only allows what the row-level security policies in
# supabase/migrations allow. Never put the project's secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
